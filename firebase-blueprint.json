{
  "entities": {
    "Wallpaper": {
      "title": "Wallpaper",
      "description": "Streamer wallpapers, showcase items, and game gallery",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "gallery": {
          "type": "array"
        },
        "gameFrames": {
          "type": "array"
        }
      },
      "required": ["title", "subtitle", "url", "order"]
    }
  },
  "firestore": {
    "/wallpapers/{wallpaperId}": {
      "schema": "Wallpaper",
      "description": "Collection of wallpaper pages and media configurations"
    }
  }
}
